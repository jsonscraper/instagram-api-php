{
  "name": "jsonscraper/instagram-api-php",
  "description": "Instagram Scraper API client for PHP with Composer and response models",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "sergeykomlev/lazyjsonmapper": "^2.0.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "JsonScraper\\": "src/"
    }
  },
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-scraper",
    "scraper-api",
    "jsonscraper",
