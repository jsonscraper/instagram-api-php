{
  "name": "jsonscraper/sdk",
  "description": "Official PHP SDK for jsonscraper Instagram and TikTok APIs",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "sergeykomlev/lazyjsonmapper": "^2.0.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "JsonScraper\\": "src/"
    }
  },
  "keywords": [
    "instagram",
    "tiktok",
    "api",
    "sdk"
  ],
  "homepage": "https://jsonscraper.com"
}
